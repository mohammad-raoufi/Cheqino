{
  "name": "cheqino-mobile-android",
  "version": "1.0.0",
  "description": "Capacitor Android wrapper for Cheqino",
  "private": true,
  "scripts": {
    "sync": "npm run build --prefix ../../apps/web && rm -rf www && cp -R ../../apps/web/dist www && rm -f www/CNAME && npx cap sync android",
    "build:debug": "cd android && ./gradlew assembleDebug"
  },
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/push-notifications": "^8.1.2"
  }
}
